// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Link {
  id          String   @id @default(cuid())
  slug        String   @unique
  originalUrl String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clicks      Click[]
  // Redirect type: 301 or 302
  redirectType Int      @default(302)
  
  // Rules for redirection
  rules       Rule[]
}

model Rule {
  id          String  @id @default(cuid())
  type        String  // "geo", "device", "rotator"
  value       String  // e.g. "US", "mobile", or weight
  targetUrl   String
  linkId      String
  link        Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  device    String?
}
